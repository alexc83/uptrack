# UpTrack local demo environment template.
#
# HOW TO USE
#   1. Copy this file to backend/.env.local  (backend/.env.local is git-ignored,
#      so these values are never committed).
#   2. Replace the placeholder values with local-only secrets, e.g.:
#        AUTH_JWT_SECRET=$(openssl rand -hex 32)
#   3. Start the backend from backend/ with:
#        set -a; . ./.env.local; set +a; ./mvnw spring-boot:run
#
# SAFETY
#   - These values are for the LOCAL loopback environment only
#     (PostgreSQL on localhost:5432, database uptrack_migration_test,
#     role uptrack_m01). Never reuse them against a hosted or production
#     backend or database.

# 8080 is the default; use another local port if it is already taken.
SERVER_PORT=8080

# Isolated local development/test database only.
DB_URL=jdbc:postgresql://localhost:5432/uptrack_migration_test
DB_USERNAME=uptrack_m01
# Local PG uses trust auth on 127.0.0.1, so any placeholder works here.
DB_PASSWORD=local-trust-placeholder

# Local-only JWT signing secret (must be >= 32 bytes for HS256).
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32
AUTH_JWT_EXPIRATION_SECONDS=3600

# Placeholder Cloudinary values: certificate upload success is NOT exercised
# in local demo mode.
CLOUDINARY_CLOUD_NAME=dev-demo-placeholder
CLOUDINARY_API_KEY=dev-demo-placeholder
CLOUDINARY_API_SECRET=dev-demo-placeholder

# Local dev servers only (React Vite defaults to 5173; Angular used 4200).
# The wildcard ports keep any local Vite port working (e.g. when 5173 is busy).
ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
