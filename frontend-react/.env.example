# UpTrack React frontend — environment variable template.
#
# HOW TO USE
#   Copy this file to `.env.local` (git-ignored) and adjust for your local setup:
#     cp .env.example .env.local
#   Vite loads `.env.local` automatically in dev and build. Never commit real
#   values; this app holds no secrets — all backend secrets live in
#   backend/.env.local (see scripts/dev-demo/env.example).

# Base URL of the REST API, as seen by the browser (build-time, Vite env).
# Default "/api" — same-origin — which the Vite dev server proxies to the
# backend, so no CORS configuration is needed for local development.
VITE_API_BASE_URL=/api

# Target of the dev-server proxy for "/api" (read in vite.config.ts).
# Default http://localhost:8080 — the Spring Boot default (SERVER_PORT).
# Use another local port only if 8080 is taken by a different application.
VITE_PROXY_TARGET=http://localhost:8080
