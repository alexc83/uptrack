#!/bin/sh
# .githooks/pre-commit
# Opt-in hook to validate Git author and committer before commit creation
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
VALIDATOR="$REPO_ROOT/scripts/validate-git-attribution.sh"

if [ -f "$VALIDATOR" ]; then
  exec "$VALIDATOR" --pre-commit "$@"
else
  echo "WARNING: [git-attribution] $VALIDATOR not found; skipping pre-commit attribution check." >&2
fi
